# MongoDB connection string (e.g., mongodb+srv://<user>:<pass>@cluster.mongodb.net/taskmanagement)
MONGODB_URI=

# JWT secret (any long random string, e.g., generate with: openssl rand -hex 64)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173

# Node environment
NODE_ENV=development
